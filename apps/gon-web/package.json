{
  "name": "@gon/web",
  "version": "0.1.0",
  "private": true,
  "description": "GON production web application and /v1 API (P04 vertical slices).",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/production",
    "test:postgres": "vitest run tests/integration",
    "test:watch": "vitest tests/production",
    "test:legacy": "node --test tests/app.test.js ux-prototype/tests/prototype.test.js",
    "db:check": "node scripts/check-migrations.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "spike:search": "node scripts/spike-hybrid-search.mjs"
  },
  "dependencies": {
    "@auth/pg-adapter": "1.11.3",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
