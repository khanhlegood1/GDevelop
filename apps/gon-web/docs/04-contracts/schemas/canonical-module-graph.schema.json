{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gon.org/schemas/module-graph/1.0/schema.json",
  "title": "GON Canonical Module Graph 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "sources",
    "nodes",
    "edges",
    "rubrics",
    "renderTargets",
    "provenance",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gon.module-graph/1.0"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "locale",
        "estimatedMinutes",
        "difficulty",
        "outcomes",
        "concepts",
        "prerequisites",
        "safetyNotices"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "difficulty": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        },
        "safetyNotices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "rubrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rubric"
      }
    },
    "renderTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "web"
      },
      "items": {
        "enum": [
          "web",
          "infographic",
          "video",
          "image_sequence",
          "easy_task",
          "teach_back",
          "gdevelop_game"
        ]
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationCoverage",
        "unverifiedClaimIds"
      ],
      "properties": {
        "citationCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unverifiedClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "conceptIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "conceptIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "role": {
          "enum": [
            "core",
            "supporting",
            "prerequisite"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "rightsStatus",
        "locators"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "user_artifact",
            "external_web",
            "external_video",
            "dataset",
            "creator_reference"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^art_"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rightsStatus": {
          "enum": [
            "user_provided",
            "link_only",
            "licensed",
            "public_reference",
            "unknown"
          ]
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "page",
                  "section",
                  "timestamp",
                  "span",
                  "url_fragment"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "artifactId"
          ]
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "support"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "locator": {
          "type": "string",
          "maxLength": 300
        },
        "support": {
          "enum": [
            "supports",
            "background",
            "contrasts"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "conceptIds",
        "content",
        "citations",
        "accessibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "enum": [
            "concept",
            "diagnostic",
            "retrieval",
            "quiz",
            "flashcard_deck",
            "reorder",
            "transfer",
            "reflection",
            "boss_proof",
            "teach_back",
            "media_brief",
            "game_template"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        },
        "content": {
          "type": "object"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textAlternative"
          ],
          "properties": {
            "textAlternative": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "transcript": {
              "type": "string"
            },
            "keyboardEquivalent": {
              "type": "boolean"
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rubricId",
            "masteryTarget",
            "revealPolicy"
          ],
          "properties": {
            "rubricId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "minLength": 1,
              "maxLength": 128
            },
            "masteryTarget": {
              "enum": [
                "recall",
                "apply",
                "create",
                "teach"
              ]
            },
            "revealPolicy": {
              "enum": [
                "after_submit",
                "immediate",
                "never"
              ]
            },
            "requiredForCompletion": {
              "type": "boolean",
              "default": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "retrieval",
                  "quiz",
                  "flashcard_deck",
                  "reorder",
                  "transfer",
                  "boss_proof",
                  "teach_back"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assessment"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "concept"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromNodeId",
        "toNodeId",
        "type"
      ],
      "properties": {
        "fromNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "toNodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "enum": [
            "sequence",
            "prerequisite",
            "remediation",
            "optional"
          ]
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "criteria",
        "passRule",
        "evidenceTypes",
        "feedbackGuidance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "weight",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "passRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "all_required",
                "weighted_threshold"
              ]
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "evidenceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "text",
              "artifact",
              "choice",
              "reorder",
              "game_events",
              "teach_back"
            ]
          }
        },
        "feedbackGuidance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "xpRuleId": {
          "type": "string",
          "pattern": "^xp\\."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdByType",
        "sourceArtifactIds",
        "attribution"
      ],
      "properties": {
        "createdByType": {
          "enum": [
            "user",
            "ai_assisted",
            "system_seed"
          ]
        },
        "createdByUserId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^usr_"
        },
        "sourceArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^art_"
          }
        },
        "generation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "agentPipelineVersion",
            "modelIds",
            "promptTemplateVersions"
          ],
          "properties": {
            "brewJobId": {
              "type": "string",
              "pattern": "^job_"
            },
            "agentPipelineVersion": {
              "type": "string"
            },
            "modelIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "promptTemplateVersions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "displayName"
          ],
          "properties": {
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "upstreamModuleVersionId": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^modv_"
            }
          }
        }
      }
    }
  }
}
