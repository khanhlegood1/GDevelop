{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gon.org/schemas/game-events/1.0/schema.json",
  "title": "GON Game Event Batch 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gon.game-events/1.0"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^game_"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientEventId",
          "sequence",
          "eventType",
          "occurredAtClient",
          "data"
        ],
        "properties": {
          "clientEventId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "eventType": {
            "enum": [
              "session_started",
              "objective_viewed",
              "action_performed",
              "checkpoint_reached",
              "question_answered",
              "session_completed",
              "session_abandoned"
            ]
          },
          "occurredAtClient": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
