# GON — GCP deployment configuration (P06-S1)
# Copy to gcp.env (git-ignored) and adjust before running the numbered scripts:
#   cp gcp.env.example gcp.env
# Everything the scripts needs lives here; no flags to remember.
# STATUS: NOT RUN — package only (see deploy/gcp/README.md).

# --- Core -----------------------------------------------------------------
GCP_PROJECT_ID="gon-staging"            # target GCP project (must have billing)
GCP_REGION="asia-southeast1"            # Singapore (closest to VN)
GCP_AR_REPO="gon"                       # Artifact Registry docker repo
GCP_AR_LOCATION="asia-southeast1"       # AR location (usually = region)

# --- Public identity ------------------------------------------------------
GON_DOMAIN="staging.gon.org"            # DNS name for the LB cert (NOT gon.org for staging)
GON_PUBLIC_ORIGIN="https://staging.gon.org"

# --- Services (Cloud Run) -------------------------------------------------
RUN_SERVICE_WEB="gon-web"
RUN_SERVICE_ADK="gon-adk"
RUN_SERVICE_WORKER="gon-worker"
RUN_SERVICE_ACCOUNT="gon-run"           # runtime SA (created in 20-database.sh)
GCS_SIGNER_ACCOUNT="gon-gcs-signer"     # SA whose key signs upload URLs (30-secrets.sh)

# --- Cloud SQL ------------------------------------------------------------
SQL_INSTANCE="gon-pg"                   # instance name
SQL_DB="gon"
SQL_USER="gon_app"
SQL_TIER="db-custom-1-3840"             # staging; raise for production
SQL_PG_VERSION="17"                     # Cloud SQL with pgvector
SQL_BACKUP_HOUR="19"                    # 19 UTC = 02:00 +07 (VN)

# --- Storage --------------------------------------------------------------
BUCKET_UPLOADS="gon-staging-uploads"    # private; signed-URL direct upload
BUCKET_EXPORTS="gon-staging-exports"    # data exports + DR drill copies

# --- Secrets (Secret Manager names; values set in 30-secrets.sh) ----------
SECRET_DB_PASSWORD="gon-db-password"
SECRET_DATABASE_URL="gon-database-url"
SECRET_AUTH_SECRET="gon-auth-secret"
SECRET_GOOGLE_OAUTH_ID="gon-auth-google-id"
SECRET_GOOGLE_OAUTH_SECRET="gon-auth-google-secret"
SECRET_GEMINI_API_KEY="gon-gemini-api-key"
SECRET_ADK_SERVICE_TOKEN="gon-adk-service-token"
SECRET_ABUSE_HASH_SALT="gon-abuse-hash-salt"
SECRET_INVITE_CODE="gon-invite-code"
SECRET_GCS_SIGNER_KEY="gon-gcs-signer-private-key"
SECRET_OUTBOX_SINK_TOKEN="gon-outbox-sink-token"

# --- App composition ------------------------------------------------------
GON_ADK_ENV_VALUE="staging"             # ADK: staging|production (never local)
GON_BREW_EXECUTION_MODE_VALUE="queued"  # staging shape: durable queue + worker
GON_OUTBOX_SINK_URL=""                  # REQUIRED for gon-worker (55-worker.sh).
                                        # Any HTTPS receiver that accepts the
                                        # P03 outbox event batch contract with a
                                        # bearer token (e.g. Pub/Sub push
                                        # endpoint or a relay you operate).

# --- Observability --------------------------------------------------------
ALERT_EMAIL="ops@gon.org"               # notification channel for alert policies
BILLING_ACCOUNT_ID=""                   # gcloud billing accounts list — budget alerts
BUDGET_AMOUNT_MICROS="500000000"        # 500 USD default (1_000_000 micros = 1 USD)

# --- Deploy tag -----------------------------------------------------------
DEPLOY_TAG="$(date -u +%Y%m%dT%H%M%SZ)"
